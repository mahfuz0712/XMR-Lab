<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="vertical">

    <LinearLayout
        style="@style/IntroContent"
        android:orientation="vertical"
        android:layout_height="wrap_content"
        android:paddingTop="64dp"
        android:paddingBottom="116dp"
        android:gravity="center_vertical">

        <com.zalexdev.stryker.appintro.MuxIntroGraphic
            android:id="@+id/welcome_mark"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/welcome_eyebrow"
            style="@style/IntroEyebrow"
            android:layout_gravity="center_horizontal"
            android:text="XMR LAB // INITIALIZATION" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/welcome_title"
            style="@style/IntroTitle"
            android:gravity="center"
            android:text="Welcome to XMR Lab" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/welcome_subtitle"
            style="@style/IntroSubtitle"
            android:gravity="center"
            android:text="A mobile Linux security environment. Configure your system and prepare your workspace." />

    </LinearLayout>

</ScrollView>

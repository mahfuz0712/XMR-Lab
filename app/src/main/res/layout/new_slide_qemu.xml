<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

<LinearLayout
    style="@style/IntroContent"
    android:gravity="center"
    android:paddingTop="48dp"
    android:paddingBottom="96dp">


    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/install_working"
        android:layout_gravity="center_horizontal"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="2dp"
        app:lottie_colorFilter="@color/intro_text"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/icon_morph" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/install_eyebrow"
        style="@style/IntroEyebrow"
        android:layout_gravity="center_horizontal"
        android:text="@string/intro_eyebrow_install" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/status_title"
        style="@style/IntroTitle"
        android:gravity="center"
        android:text="@string/install_state_running" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/status_spinner"
            style="@style/IntroStatusSpinner"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/status_icon"
            style="@style/IntroStatusIcon"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status_subtitle"
            style="@style/IntroSubtitle"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:text="@string/intro_install_body" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/slide_install_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        app:indicatorColor="?attr/muxPrimary"
        app:trackColor="@color/mux_track"
        app:trackCornerRadius="0dp"
        app:indicatorTrackGapSize="0dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="7dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/download_text"
        style="@style/IntroStatusDetail"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/install_details_toggle"
        style="@style/Widget.Mux.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:minHeight="44dp"
        android:text="@string/intro_view_logs" />
</LinearLayout>
</ScrollView>

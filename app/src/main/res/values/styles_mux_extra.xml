<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Quiet button: transparent fill, dim border and text (Close, Back, Skip) -->
    <style name="Widget.Mux.Button.Ghost" parent="Widget.Mux.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">?attr/muxDim</item>
        <item name="iconTint">?attr/muxDim</item>
        <item name="android:textColor">?attr/muxDim</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Icon-only square button, same cut corners as Widget.Mux.Button -->
    <style name="Widget.Mux.IconButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.Mux.Small</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="strokeColor">@color/mux_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/mux_button_fill</item>
        <item name="rippleColor">@color/mux_button_ripple</item>
        <item name="iconTint">@color/mux_button_text</item>
    </style>

    <!-- Small square status tag (WPS, PIXIE, 5G ...) -->
    <style name="Widget.Mux.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Mux.Tag.Cyan" parent="Widget.Mux.Tag">
        <item name="android:background">@drawable/mux_tag_cyan</item>
        <item name="android:textColor">#28D8EF</item>
    </style>

    <style name="Widget.Mux.Tag.Gold" parent="Widget.Mux.Tag">
        <item name="android:background">@drawable/mux_tag_gold</item>
        <item name="android:textColor">#E6A91E</item>
    </style>

    <style name="Widget.Mux.Tag.Green" parent="Widget.Mux.Tag">
        <item name="android:background">@drawable/mux_tag_green</item>
        <item name="android:textColor">#42D58B</item>
    </style>

    <style name="Widget.Mux.Tag.Red" parent="Widget.Mux.Tag">
        <item name="android:background">@drawable/mux_tag_red</item>
        <item name="android:textColor">#E34C59</item>
    </style>

    <style name="Widget.Mux.Tag.Dim" parent="Widget.Mux.Tag">
        <item name="android:background">@drawable/mux_tag_dim</item>
        <item name="android:textColor">#6A94A1</item>
    </style>
</resources>
